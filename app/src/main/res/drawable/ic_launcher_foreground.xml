<?xml version="1.0" encoding="utf-8"?>
<!--
  应用图标前景：一本翻开的书 + 一滴墨。
  自适应图标的前景层会被系统裁切，因此图形必须落在中心 66% 的安全区内
  （108dp 画布 → 安全区约 72dp，即中心 18~90 之间）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 书脊 -->
    <path
        android:strokeColor="#8A6A46"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M54,34 L54,76" />

    <!-- 左页 -->
    <path
        android:fillColor="#EFE6D6"
        android:strokeColor="#8A6A46"
        android:strokeWidth="3"
        android:strokeLineJoin="round"
        android:pathData="M54,36 C48,31.5 40.5,30 33,29.6 L33,72 C40.5,72.4 48,73.9 54,78.4 Z" />

    <!-- 右页 -->
    <path
        android:fillColor="#EFE6D6"
        android:strokeColor="#8A6A46"
        android:strokeWidth="3"
        android:strokeLineJoin="round"
        android:pathData="M54,36 C60,31.5 67.5,30 75,29.6 L75,72 C67.5,72.4 60,73.9 54,78.4 Z" />

    <!-- 墨点 -->
    <path
        android:fillColor="#33302B"
        android:pathData="M54,52 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0" />
</vector>
